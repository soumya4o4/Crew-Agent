WHATSAPP_VERIFY_TOKEN=my_secure_flight_token_123
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_APP_SECRET=your_app_secret
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# OpenAI powers smarter routing, visa document checks and the Buddy chat (without a key: keyword routing, no Buddy)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
# Visa team API token (any long random string) and optional demo mode
ADMIN_TOKEN=
VISA_DEMO_AUTOPROGRESS=false
# Hotelbeds live hotel search (test keys use api.test.hotelbeds.com; set HOTELBEDS_BASE_URL=https://api.hotelbeds.com for live)
HOTELBEDS_API_KEY=
HOTELBEDS_SECRET=
# HOTELBEDS_MARKUP_PCT=0

# Duffel live flight search and booking (duffel_test_ tokens use the sandbox, duffel_live_ for real tickets)
DUFFEL_API_TOKEN=
# DUFFEL_MARKUP_PCT=0
# DUFFEL_CONTACT_EMAIL=   # lead-passenger email when payments are off (with Razorpay, the email asked at checkout is used)
